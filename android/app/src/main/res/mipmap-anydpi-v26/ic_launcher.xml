<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+).

  The 108dp canvas is 33% larger than the 72dp area the launcher actually
  shows, so artwork drawn edge to edge gets cropped. `ic_launcher_foreground`
  therefore scales the ex-logo mark into the inner 66dp safe circle, which
  stays visible under every launcher mask shape (circle, squircle, rounded
  square) instead of being clipped.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
